FLASK_SECRET_KEY=
FERNET_KEY=
WG_RESELLER_ENCRYPTION_KEY=
WG_RESELLER_PREVIOUS_KEYS=
WG_RESELLER_LEGACY_SECRET=
API_KEY=
DATABASE_URL=postgresql+psycopg://wgpanel:CHANGE_ME@127.0.0.1:5432/wgpanel
WG_AUTO_UPGRADE=1
PG_POOL_SIZE=5
PG_MAX_OVERFLOW=5
PG_POOL_TIMEOUT=10

LOG_LEVEL=INFO
SECURE_COOKIES=1
WG_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128
WG_TRUSTED_HOSTS=
WIREGUARD_CONF_PATH=/etc/wireguard

SETUP_TOKEN=
TG_HEARTBEAT_SEC=60
WG_ONLINE_PROBE_FIRST=1
WG_ONLINE_HANDSHAKE_FALLBACK=0
WG_ONLINE_HANDSHAKE_WINDOW=45

WG_BACKUP_ENCRYPTION_KEY=
WG_BACKUP_PREVIOUS_KEYS=

