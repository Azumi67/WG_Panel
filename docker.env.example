# Docker Compose overrides. Copy to .env if you want to customize them.

WG_PANEL_BIND=0.0.0.0:8000
WG_NODE_BIND=0.0.0.0:9898
LOG_LEVEL=INFO
SECURE_COOKIES=0
DATABASE_URL=sqlite:///instance/wg_panel.db
TG_HEARTBEAT_SEC=60
WG_ONLINE_PROBE_FIRST=1
WG_ONLINE_HANDSHAKE_FALLBACK=0
WG_ONLINE_HANDSHAKE_WINDOW=45

FLASK_SECRET_KEY=
FERNET_KEY=
API_KEY=
SETUP_TOKEN=

# Optional Telegram profile.
PANEL_BASE_URL=http://127.0.0.1:8000
TG_BOT_TOKEN=

# Optional remote node-agent profile. If blank, a key is generated and saved
# inside the wg_node_agent_instance volume.
NODE_API_KEY=
